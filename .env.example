# --- Logging Configuration ---
# Recommended levels: trace, debug, info, warn, error
RUST_LOG_FILE=trace
# Unset = info,sqlx=warn,tower_governor=warn (warnings and the access log
# of method, route, status and latency). Recommended in production too.
RUST_LOG_CONSOLE=info,sqlx=warn,tower_governor=warn

# Set to true to create a 'logs' folder and save logs to files
LOG_TO_FILE=false
# Console format: `pretty` (multi-line, coloured; default of debug builds)
# or `compact` (one plain line per event; default of release builds).
# LOG_FORMAT=compact

# --- Authentication (JWT) ---
# WARNING: JWT_SECRET must be at least 32 characters long.
JWT_SECRET=replace_this_value_with_a_secure_32_char_secret
# Token expiration time in seconds (86400 = 24 hours)
JWT_EXPIRATION_TIME=86400
# How long a staff "view as another user" session lasts, in seconds
IMPERSONATION_EXPIRATION_TIME=3600
# New passwords are checked against Have I Been Pwned (k-anonymity range
# query, 2 s timeout, fails open). Set to true to skip it (offline setups).
# DISABLE_BREACHED_PASSWORD_CHECK=false

# --- Public web origin (links in e-mails) ---
APP_BASE_URL=http://localhost:3000
# Public origin of this API (no trailing slash). When set, e-mails that can
# be unsubscribed from carry an RFC 8058 one-click `List-Unsubscribe`
# header pointing at <API_PUBLIC_URL>/api/v1/public/email/unsubscribe/one-click
# (Gmail and Yahoo require it from bulk senders); unset, only the web
# unsubscribe page is advertised.
# API_PUBLIC_URL=https://api.setlyst.com.br

# --- Encryption of secrets at rest (TOTP seeds) ---
# REQUIRED: 32 random bytes, base64. Generate your own with:
#   openssl rand -base64 32
# Keep it with your other secrets and never change it: two-factor secrets
# stored with one key can't be read with another. The server refuses to
# start without it.
DATA_ENCRYPTION_KEY=
# Local development only: set to true to derive the key from JWT_SECRET
# instead (a warning is logged; rotating JWT_SECRET then breaks every 2FA
# account). Never enable in production.
# ALLOW_DERIVED_DATA_KEY=false

# --- Runtime assets ---
# Directory holding `fonts/` (PDF export). Defaults to ./assets, or the
# source tree's assets directory when the binary runs from elsewhere.
# ASSETS_DIR=/opt/setlyst/assets

# --- Client IP resolution (rate limiting and audit) ---
# Proxies whose X-Forwarded-For header is trusted (CIDRs, comma-separated).
# Behind Render: 10.0.0.0/8 (its private network). If the rightmost
# untrusted hop turns out to be a Cloudflare edge, add Cloudflare's ranges.
# Rate limits are keyed by client address, IPv6 by its /64.
TRUSTED_PROXIES=
# Shared secret the web server sends as X-Setlyst-Internal together with
# the visitor's address in X-Setlyst-Client-IP. Same value as the web app
# (at least 32 random bytes); the web must send it on every server-side call.
# INTERNAL_API_SECRET=
# A release build refuses to start with neither TRUSTED_PROXIES nor
# INTERNAL_API_SECRET: behind a proxy every visitor would share one
# rate-limit bucket (one script could lock everyone out of signing in).
# Set this only when clients really connect to the API directly.
# ALLOW_DIRECT_CLIENTS=false

# --- Google sign-in ---
# OAuth client IDs accepted as the audience of Google ID tokens.
# Empty disables Google sign-in.
GOOGLE_CLIENT_IDS=

# --- E-mail (SMTP) ---
# When SMTP_HOST is unset, e-mails are not sent (a debug build prints them
# to the log instead). A release build refuses to start with an invalid
# SMTP configuration.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# starttls | tls | none
# SMTP_TLS=starttls
# SMTP_FROM=Setlyst <no-reply@setlyst.com.br>
# SMTP_REPLY_TO=
#
# Resend (https://resend.com/docs/send-with-smtp): the username is the
# literal word `resend` and the password is an API key. Use port 2465:
# Render's free instances block outbound 25, 465 and 587, and a blocked
# port only shows up as delivery timeouts in the logs.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=2465
# SMTP_TLS=tls
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_xxxxxxxxxxxxxxxx
# SMTP_FROM=Setlyst <no-reply@mail.your-domain.com>
EMAIL_WORKER_INTERVAL_SECS=10
# Non-security e-mails (notifications, announcements, release notes...)
# sent per hour, process-wide. Past it only codes and security notices go
# out until the hour frees up, and an error is logged: keep it below the
# provider's quota so password resets never stop.
# EMAIL_HOURLY_CAP=500

# --- Payments (Stripe) ---
# Both unset = payments off (checkout answers PAYMENTS_UNAVAILABLE).
# Test-mode keys (sk_test_...) in development and staging. In production use
# a restricted key (rk_live_...) with these permissions. At startup the API
# probes the read scopes: a missing one is logged, and with a live key a
# scope Stripe refuses (403) stops the server (every paid invoice would fail
# to be recorded). Stripe being unreachable is only logged.
#   Write: Customers, Products, Prices, Coupons, Checkout Sessions,
#          Subscriptions, Customer portal, Refunds
#   Read:  Invoices, Invoice Payments, Charges, Disputes, Payment Intents
#          (Stripe fees), Refunds
# The webhook secret belongs to the endpoint <api>/api/v1/webhooks/stripe;
# with the Stripe CLI (`stripe listen`) it's the whsec_ it prints. Use one
# endpoint (and secret) per mode: events from the other mode are ignored.
# Events the endpoint must send:
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.expired,
#   customer.subscription.created, customer.subscription.updated,
#   customer.subscription.deleted, customer.subscription.paused,
#   customer.subscription.resumed, customer.subscription.pending_update_applied,
#   customer.subscription.pending_update_expired,
#   customer.subscription.trial_will_end, customer.deleted,
#   invoice.paid, invoice.payment_failed, invoice.payment_action_required,
#   invoice.upcoming (yearly renewal reminders),
#   charge.refunded, refund.created, refund.updated, charge.refund.updated,
#   charge.dispute.created, charge.dispute.updated, charge.dispute.closed
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
# Only for stripe-mock or a proxy.
# STRIPE_API_BASE=https://api.stripe.com

# --- Moderation ---
# Google Cloud Vision key for image classification (optional). Restrict it
# to the Vision API and set a daily request quota in the GCP console too.
# MODERATION_VISION_API_KEY=
# Classifications allowed per UTC day (counted in the database, shared by
# every instance). Past it, new avatars and logos are queued for manual
# review (`review_pending` flags) instead. At most 4 run at once.
# MODERATION_VISION_DAILY_BUDGET=2000

# --- Announcements ---
# Hosts (comma-separated) an announcement button may link to besides app
# paths (/dashboard/...), over https only. Unset: app paths only.
# ANNOUNCEMENT_CTA_HOSTS=setlyst.com.br,blog.setlyst.com.br

# --- Trash ---
TRASH_RETENTION_DAYS=30

# --- Release-build guards ---
# A live payment key (sk_live_/rk_live_) is refused unless STRIPE_API_BASE
# is https://api.stripe.com and APP_BASE_URL is https. A test-mode key in a
# release build logs an error at startup unless this is true (staging).
# ALLOW_TEST_PAYMENTS=false

# --- API documentation ---
# Serve /swagger-ui and /api-docs/openapi.json. Defaults to true in debug
# builds and false in release builds.
# ENABLE_SWAGGER=false

# --- Security & Server Configuration ---
# Allowed URLs separated by commas
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Port the API listens on (all interfaces). Hosting platforms set it.
PORT=8000

# --- Database Configuration ---
# PostgreSQL credentials
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=local_db

# Connection URL built from the variables above
# Format: postgres://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/local_db
# Size of the connection pool. Keep it well below the server's
# max_connections on small instances.
DATABASE_MAX_CONNECTIONS=10
# Apply pending migrations on startup (set to false if you run them yourself)
RUN_MIGRATIONS=true
# Every new connection sets statement_timeout=15s,
# idle_in_transaction_session_timeout=30s and lock_timeout=5s. Behind a
# transaction-mode pooler (Neon `-pooler`, PgBouncer) session settings don't
# stick: set this to true and put them on the role instead:
#   ALTER ROLE app SET statement_timeout = '15s';
#   ALTER ROLE app SET idle_in_transaction_session_timeout = '30s';
#   ALTER ROLE app SET lock_timeout = '5s';
# DATABASE_SKIP_SESSION_SETTINGS=false

# --- Integration tests (cargo test) ---
# A PostgreSQL server the tests may create throwaway databases on.
# Tests are skipped when unset.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres